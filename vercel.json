{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.(?:js|css|png|jpe?g|webp|svg|mp4|webm|h264|mp3|mpeg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
